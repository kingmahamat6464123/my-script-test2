	fovSliderFill.Size = UDim2.new(ratio, 0, 1, 0)
	fovSliderKnob.Position = UDim2.new(ratio, 0, 0.5, 0)
end

local function setFOVSizeFromPointer(pointerX, track)
	local trackStart = track.AbsolutePosition.X
	local trackWidth = track.AbsoluteSize.X
	if trackWidth > 0 then
		local ratio = math.clamp((pointerX - trackStart) / trackWidth, 0, 1)
		setFOVSize(50 + ratio * (700 - 50))
	end
end

local function beginFOVDrag(input, track)
	if input.UserInputType == Enum.UserInputType.MouseButton1 then
		draggingFOV = true
		activeFOVTrack = track
		setFOVSizeFromPointer(input.Position.X, track)
	elseif input.UserInputType == Enum.UserInputType.Touch then
		draggingFOV = true
		activeFOVTouch = input
		activeFOVTrack = track
		setFOVSizeFromPointer(input.Position.X, track)
	end
end

local function setMovementSliderValue(slider, value, applyValue)
	local stepCount = math.floor((value - slider.Minimum) / slider.Step + 0.5)
	value = math.clamp(slider.Minimum + stepCount * slider.Step, slider.Minimum, slider.Maximum)
	slider.Value = value
	local ratio = (value - slider.Minimum) / (slider.Maximum - slider.Minimum)
	if slider == triggerBotFOVSlider then
		slider.Label.Text = string.format("%s: %d px", slider.Name, value)
	elseif slider.Step < 1 then
		slider.Label.Text = string.format("%s: %.2f", slider.Name, value)
	else
		slider.Label.Text = string.format("%s: %d", slider.Name, value)
	end
	slider.Fill.Size = UDim2.new(ratio, 0, 1, 0)
	slider.Knob.Position = UDim2.new(ratio, 0, 0.5, 0)
	if applyValue then
		if slider == walkSpeedSlider then
			applyWalkSpeed(value)
		elseif slider == jumpPowerSlider then
			applyJumpPower(value)
		elseif slider == flySpeedSlider then
			flySpeed = value
		elseif slider == triggerBotFOVSlider then
			triggerBotFOV = math.clamp(value, 1, 30)
			updateTriggerFOVCircle()
		elseif slider == triggerBotDelaySlider then
			triggerBotDelay = value
		end
	end
end

local function setMovementSliderFromPointer(pointerX)
	local track = activeMovementSlider.Track
	local trackWidth = track.AbsoluteSize.X
	if trackWidth <= 0 then
		return
	end
	local ratio = math.clamp((pointerX - track.AbsolutePosition.X) / trackWidth, 0, 1)
	local slider = activeMovementSlider
	setMovementSliderValue(slider, slider.Minimum + ratio * (slider.Maximum - slider.Minimum), true)
end

