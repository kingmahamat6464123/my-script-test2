local function removeHighlight(player)
	local highlight = highlights[player]
	if highlight then
		highlight:Destroy()
		highlights[player] = nil
	end
end

local function shouldShowEspPlayer(player)
	if player == localPlayer then
		return false
	end
	return true
end

local function updateHighlight(player)
	removeHighlight(player)
	if not espEnabled or not shouldShowEspPlayer(player) then
		return
	end

	local character = player.Character
	if not character then
		return
	end

	local highlight = Instance.new("Highlight")
	highlight.Name = "AdminPlayerESP"
	highlight.Adornee = character
	highlight.FillColor = Color3.fromRGB(255, 80, 80)
	highlight.OutlineColor = Color3.new(1, 1, 1)
	highlight.FillTransparency = 0.65
	highlight.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
	highlight.Parent = character
	highlights[player] = highlight
end

local function removeSquareESP(player)
	local box = squareObjects[player]
	if box then
		box:Destroy()
		squareObjects[player] = nil
	end
end

local function updateSquareESP(player)
	removeSquareESP(player)
	if not squareEspEnabled or not shouldShowEspPlayer(player) then
		return
	end

	local character = player.Character
	local root = character and character:FindFirstChild("HumanoidRootPart")
	if not root then
		return
	end

	local boundsCFrame, boundsSize = character:GetBoundingBox()
	local box = Instance.new("BoxHandleAdornment")
	box.Name = "AdminSquareESP"
	box.Adornee = root
	box.CFrame = root.CFrame:ToObjectSpace(boundsCFrame)
	box.Size = boundsSize
	box.Color3 = Color3.fromRGB(80, 220, 190)
	box.Transparency = 0.35
	box.AlwaysOnTop = true
	box.ZIndex = 5
	box.Parent = root
	squareObjects[player] = box
end

local function removeInfoESP(player)
	local data = infoEspObjects[player]
	if not data then
		return
	end
	if data.healthConnection then
		data.healthConnection:Disconnect()
	end
	if data.maxHealthConnection then
		data.maxHealthConnection:Disconnect()
	end
	if data.diedConnection then
		data.diedConnection:Disconnect()
	end
	if data.characterConnection then
		data.characterConnection:Disconnect()
	end
	if data.billboard then
		data.billboard:Destroy()
	end
	infoEspObjects[player] = nil
end

local function updateInfoESP(player)
	removeInfoESP(player)
	if not infoEspEnabled or not shouldShowEspPlayer(player) then
		return
