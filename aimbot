local noclipDescendantConnection

local function applyNoclipToPart(part)
	if not part:IsA("BasePart") then
		return
	end
	if noclipCollisionStates[part] == nil then
		noclipCollisionStates[part] = part.CanCollide
	end
	part.CanCollide = false
end

local function restoreNoclipParts()
	if noclipDescendantConnection then
		noclipDescendantConnection:Disconnect()
		noclipDescendantConnection = nil
	end
	for part, canCollide in pairs(noclipCollisionStates) do
		if part.Parent then
			part.CanCollide = canCollide
		end
		noclipCollisionStates[part] = nil
	end
end

local function setNoclipEnabled(enabled)
	noclipEnabled = enabled
	if not enabled then
		restoreNoclipParts()
	else
		restoreNoclipParts()
		local character = localPlayer.Character
		if character then
			for _, descendant in ipairs(character:GetDescendants()) do
				applyNoclipToPart(descendant)
			end
			noclipDescendantConnection = character.DescendantAdded:Connect(applyNoclipToPart)
		end
	end
	updateMovementControls()
end

local function setFlyEnabled(enabled)
	flyEnabled = enabled
	if flyConnection then
		flyConnection:Disconnect()
		flyConnection = nil
	end

	if enabled then
		flyConnection = RunService.Heartbeat:Connect(function()
			local character = localPlayer.Character
			local humanoid = character and character:FindFirstChildOfClass("Humanoid")
			local root = character and character:FindFirstChild("HumanoidRootPart")
			local camera = workspace.CurrentCamera
			if not humanoid or humanoid.Health <= 0 or not root or not camera then
				return
			end

			if not flyHumanoidStates[humanoid] then
				flyHumanoidStates[humanoid] = {
					PlatformStand = humanoid.PlatformStand,
					AutoRotate = humanoid.AutoRotate,
				}
			end
			humanoid.PlatformStand = true
			humanoid.AutoRotate = false

			local direction = Vector3.zero
			if UserInputService:IsKeyDown(Enum.KeyCode.W) then
				direction = direction + camera.CFrame.LookVector
			end
			if UserInputService:IsKeyDown(Enum.KeyCode.S) then
				direction = direction - camera.CFrame.LookVector
			end
			if UserInputService:IsKeyDown(Enum.KeyCode.D) then
				direction = direction + camera.CFrame.RightVector
			end
			if UserInputService:IsKeyDown(Enum.KeyCode.A) then
				direction = direction - camera.CFrame.RightVector
			end
			if UserInputService:IsKeyDown(Enum.KeyCode.Space) then
				direction = direction + Vector3.yAxis
			end
			if UserInputService:IsKeyDown(Enum.KeyCode.LeftControl) or UserInputService:IsKeyDown(Enum.KeyCode.RightControl) then
				direction = direction - Vector3.yAxis
			end

			if direction.Magnitude > 1 then
				direction = direction.Unit
			end
			root.AssemblyLinearVelocity = direction * flySpeed
			root.AssemblyAngularVelocity = Vector3.zero
		end)
	else
		for humanoid, original in pairs(flyHumanoidStates) do
			if humanoid.Parent then
				humanoid.PlatformStand = original.PlatformStand
				humanoid.AutoRotate = original.AutoRotate
				if not original.PlatformStand then
					humanoid:ChangeState(Enum.HumanoidStateType.GettingUp)
				end
			end
			flyHumanoidStates[humanoid] = nil
		end
		local character = localPlayer.Character
		local root = character and character:FindFirstChild("HumanoidRootPart")
		if root then
			root.AssemblyLinearVelocity = Vector3.zero
		end
	end
	updateMovementControls()
end

