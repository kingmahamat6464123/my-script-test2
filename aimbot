local function refreshAimPlayerList()
	for _, child in ipairs(playerList:GetChildren()) do
		if child:IsA("TextButton") then
			child:Destroy()
		end
	end

	local players = Players:GetPlayers()
	table.sort(players, function(first, second)
		return string.lower(first.Name) < string.lower(second.Name)
	end)
	targetFilterLabel.Text = string.format("PLAYERS IN SERVER  /  %d", #players)

	for index, player in ipairs(players) do
		local listedPlayer = player
		local isYou = listedPlayer == localPlayer
		local isExcluded = excludedUserIds[listedPlayer.UserId] == true
		local row = Instance.new("TextButton")
		row.Name = "Player_" .. tostring(listedPlayer.UserId)
		row.LayoutOrder = index
		row.Size = UDim2.new(1, -8, 0, 28)
		row.BackgroundColor3 = isExcluded and Color3.fromRGB(103, 57, 51) or theme.Panel
		row.BorderSizePixel = 0
		row.AutoButtonColor = not isYou
		row.Text = listedPlayer.DisplayName .. "  (@" .. listedPlayer.Name .. ")"
		if isYou then
			row.Text = listedPlayer.DisplayName .. "  [YOU]"
		elseif isExcluded then
			row.Text = row.Text .. "  [EXCLUDED]"
		end
		row.TextColor3 = theme.Text
		row.TextXAlignment = Enum.TextXAlignment.Left
		row.Font = Enum.Font.GothamSemibold
		row.TextSize = 11
		row.Parent = playerList
		local rowCorner = Instance.new("UICorner")
		rowCorner.CornerRadius = UDim.new(0, 5)
		rowCorner.Parent = row

		if not isYou then
			row.Activated:Connect(function()
				if excludedUserIds[listedPlayer.UserId] then
					excludedUserIds[listedPlayer.UserId] = nil
				else
					excludedUserIds[listedPlayer.UserId] = true
					if currentAimTarget and currentAimTarget.UserId == listedPlayer.UserId then
						currentAimTarget = nil
					end
				end
				refreshAimPlayerList()
			end)
		end
	end
end

