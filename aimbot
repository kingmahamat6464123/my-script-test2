local function removeSkeletonESP(player)
	local data = skeletonObjects[player]
	if not data then
		return
	end
	if data.connection then
		data.connection:Disconnect()
	end
	if data.folder then
		data.folder:Destroy()
	end
	skeletonObjects[player] = nil
end

local function updateSkeletonESP(player)
	removeSkeletonESP(player)
	if not skeletonEspEnabled or not shouldShowEspPlayer(player) then
		return
	end

	local character = player.Character
	if not character then
		return
	end

	local folder = Instance.new("Folder")
	folder.Name = "AdminSkeletonESP_" .. tostring(player.UserId)
	folder.Parent = screenGui

	local bones = {}
	for _, joint in ipairs(character:GetDescendants()) do
		if joint:IsA("Motor6D") and joint.Part0 and joint.Part1 then
			local line = Instance.new("LineHandleAdornment")
			line.Name = "Bone_" .. joint.Name
			line.Adornee = joint.Part0
			line.Color3 = Color3.fromRGB(80, 220, 190)
			line.Thickness = 2
			line.AlwaysOnTop = true
			line.ZIndex = 5
			line.Parent = folder
			table.insert(bones, { joint = joint, line = line })
		end
	end

	if #bones == 0 then
		folder:Destroy()
		return
	end

	local function updateBones()
		for i = 1, #bones do
			local entry = bones[i]
			local motor = entry.joint
			local part0 = motor.Part0
			local part1 = motor.Part1
			if motor.Parent and part0 and part1 then
				local worldA = (part0.CFrame * motor.C0).Position
				local worldB = (part1.CFrame * motor.C1).Position
				local localA = part0.CFrame:PointToObjectSpace(worldA)
				local localB = part0.CFrame:PointToObjectSpace(worldB)
				entry.line.From = localA
				entry.line.To = localB
			end
		end
	end

	updateBones()

	skeletonObjects[player] = {
		folder = folder,
		connection = RunService.RenderStepped:Connect(updateBones),
	}
end

