local function getTargetPart(character)
	local partName = targetParts[targetPartIndex]
	if partName == "Torso" then
		return character:FindFirstChild("UpperTorso") or character:FindFirstChild("Torso")
	elseif partName == "Root" then
		return character:FindFirstChild("HumanoidRootPart")
	end
	return character:FindFirstChild("Head")
end

local aimRaycastParams = RaycastParams.new()
aimRaycastParams.FilterType = Enum.RaycastFilterType.Exclude
aimRaycastParams.IgnoreWater = true

local function getVisibleTargetPart(player, camera)
	if player == localPlayer or player.Parent ~= Players or excludedUserIds[player.UserId] then
		return nil
	end

	local character = player.Character
	local humanoid = character and character:FindFirstChildOfClass("Humanoid")
	local part = character and getTargetPart(character)
	if not humanoid or humanoid.Health <= 0 or not part or not part:IsA("BasePart") then
		return nil
	end

	if wallCheckEnabled then
		local direction = part.Position - camera.CFrame.Position
		local hit = workspace:Raycast(camera.CFrame.Position, direction, aimRaycastParams)
		if hit and not hit.Instance:IsDescendantOf(character) then
			return nil
		end
	end
	return part
end

local function updateAim()
	local camera = workspace.CurrentCamera
	if not camera or UserInputService:GetFocusedTextBox() then
		return
	end

	if wallCheckEnabled then
		aimRaycastParams.FilterDescendantsInstances = localPlayer.Character and { localPlayer.Character } or {}
	end

	local lockedPart = currentAimTarget and getVisibleTargetPart(currentAimTarget, camera)
	if lockedPart then
		camera.CFrame = CFrame.lookAt(camera.CFrame.Position, lockedPart.Position)
		return
	end
	currentAimTarget = nil

	local viewportCenter = camera.ViewportSize / 2
	local closestDistance = math.huge
	local closestPlayer
	local closestPart
	local fovRadius = aimFOVSize / 2
	local fovRadiusSquared = fovRadius * fovRadius
	for _, player in ipairs(Players:GetPlayers()) do
		local part = getVisibleTargetPart(player, camera)
		if part then
			local screenPosition, onScreen = camera:WorldToViewportPoint(part.Position)
			if onScreen then
				local offset = Vector2.new(screenPosition.X, screenPosition.Y) - viewportCenter
				local distance = offset:Dot(offset)
				if distance <= fovRadiusSquared and distance < closestDistance then
					closestDistance = distance
					closestPlayer = player
					closestPart = part
				end
			end
		end
	end

	if closestPlayer and closestPart then
		currentAimTarget = closestPlayer
		camera.CFrame = CFrame.lookAt(camera.CFrame.Position, closestPart.Position)
	end
end

local function setAimAssistEnabled(enabled)
	aimAssistEnabled = enabled
	if not enabled then
		currentAimTarget = nil
	end
	updateAimControls()
	if enabled then
		RunService:BindToRenderStep("AdminAimAssist", Enum.RenderPriority.Camera.Value + 1, updateAim)
	else
		currentAimTarget = nil
		RunService:UnbindFromRenderStep("AdminAimAssist")
	end
end

-- ============================================================================
-- TRIGGER BOT (pixel FOV, multi-part hitbox scan, short cooldown)
-- ============================================================================
local triggerAimPartsR6 = { "Head", "Torso" }
local triggerAimPartsR15 = {
	"Head",
	"UpperTorso",
	"LowerTorso",
	"LeftUpperArm", "LeftLowerArm", "LeftHand",
	"RightUpperArm", "RightLowerArm", "RightHand",
	"LeftUpperLeg", "LeftLowerLeg", "LeftFoot",
	"RightUpperLeg", "RightLowerLeg", "RightFoot",
}

local function getTriggerScanParts(character)
	local parts = {}
	local isR15 = character:FindFirstChild("UpperTorso") ~= nil
	if isR15 then
		for _, name in ipairs(triggerAimPartsR15) do
			local p = character:FindFirstChild(name)
			if p and p:IsA("BasePart") then
				table.insert(parts, p)
			end
		end
	else
		for _, name in ipairs(triggerAimPartsR6) do
			local p = character:FindFirstChild(name)
			if p and p:IsA("BasePart") then
				table.insert(parts, p)
			end
		end
	end
	if #parts == 0 then
		local root = character:FindFirstChild("HumanoidRootPart")
		if root then
			table.insert(parts, root)
		end
	end
	return parts
end

local function getClosestPlayerToCrosshair(maxPixels)
	local camera = workspace.CurrentCamera
	if not camera or not localPlayer.Character then
		return nil
	end

	local viewportCenter = camera.ViewportSize / 2
	local origin = camera.CFrame.Position

	if wallCheckEnabled then
		aimRaycastParams.FilterDescendantsInstances = { localPlayer.Character }
	end

	local bestPlayer
	local bestPixelDist = maxPixels
	for _, player in ipairs(Players:GetPlayers()) do
		if player ~= localPlayer
			and player.Parent == Players
			and not excludedUserIds[player.UserId] then
			local character = player.Character
			local humanoid = character and character:FindFirstChildOfClass("Humanoid")
			if humanoid and humanoid.Health > 0 then
				local parts = getTriggerScanParts(character)
				for _, part in ipairs(parts) do
					local screenPos, onScreen = camera:WorldToViewportPoint(part.Position)
					if onScreen then
						local offset = Vector2.new(screenPos.X, screenPos.Y) - viewportCenter
						local pixelDist = offset.Magnitude
						if pixelDist <= bestPixelDist then
							if wallCheckEnabled then
								local toPart = part.Position - origin
								local hit = workspace:Raycast(origin, toPart, aimRaycastParams)
								if hit and not hit.Instance:IsDescendantOf(character) then
									continue
								end
							end
							bestPixelDist = pixelDist
							bestPlayer = player
						end
					end
				end
			end
		end
	end
	return bestPlayer
end

local function fireWeapon()
	local character = localPlayer.Character
	if not character then
		return
	end
	local tool = character:FindFirstChildOfClass("Tool")
	if tool then
		tool:Activate()
	else
		local vim = game:GetService("VirtualInputManager")
		vim:SendMouseButtonEvent(0, 0, 0, true, game, 0)
		vim:SendMouseButtonEvent(0, 0, 0, false, game, 0)
	end
end

local triggerBotConnection

local function updateTriggerBot()
	if not triggerBotEnabled then
		return
	end
	local now = os.clock()
	if now < triggerBotNextFire then
		return
	end
	local target = getClosestPlayerToCrosshair(triggerBotFOV)
	if target then
		if triggerBotDelay > 0 then
			triggerBotNextFire = now + triggerBotDelay
			task.delay(triggerBotDelay, function()
				if triggerBotEnabled then
					fireWeapon()
				end
			end)
		else
			triggerBotNextFire = now + triggerBotCooldown
			fireWeapon()
		end
	end
end

local function setTriggerBotEnabled(enabled)
	triggerBotEnabled = enabled
	if enabled then
		if not triggerBotConnection then
			triggerBotConnection = RunService.RenderStepped:Connect(updateTriggerBot)
		end
	else
		if triggerBotConnection then
			triggerBotConnection:Disconnect()
			triggerBotConnection = nil
		end
	end
	updateAimControls()
	triggerFOVCircle.Visible = panelVisible and triggerBotEnabled
end
