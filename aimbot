local function getLocalHumanoid()
	local character = localPlayer.Character
	return character and character:FindFirstChildOfClass("Humanoid")
end

local function rememberMovementDefaults(humanoid)
	if originalMovementDefaults then
		return
	end
	originalMovementDefaults = {
		WalkSpeed = humanoid.WalkSpeed,
		JumpPower = humanoid.JumpPower,
		JumpHeight = humanoid.JumpHeight,
		UseJumpPower = humanoid.UseJumpPower,
	}
end

local function applyWalkSpeed(value)
	movementWalkSpeed = value
	walkSpeedChanged = true
	local humanoid = getLocalHumanoid()
	if humanoid then
		rememberMovementDefaults(humanoid)
		humanoid.WalkSpeed = value
	end
end

local function applyJumpPower(value)
	movementJumpPower = value
	jumpPowerChanged = true
	local humanoid = getLocalHumanoid()
	if humanoid then
		rememberMovementDefaults(humanoid)
		humanoid.UseJumpPower = true
		humanoid.JumpPower = value
	end
end

local function applyMovementOnSpawn()
	if walkSpeedChanged then
		applyWalkSpeed(movementWalkSpeed)
	end
	if jumpPowerChanged then
		applyJumpPower(movementJumpPower)
	end
end

local jumpRequestConnection = UserInputService.JumpRequest:Connect(function()
