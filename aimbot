-- Forward decls so the wrapped TELEPORT PAGE section can expose these
-- without adding locals to the top-level chunk.
local stopTeleportFollow
local refreshTeleportPlayerList

-- ============================================================================
-- TELEPORT PAGE (wrapped in a do-block so its locals don't hit the 200 cap)
-- ============================================================================
do
	local teleportFollowConnection
	local teleportFollowTarget
	local teleportHeight = 6
	local teleportWallCheck = true
	local teleportMaxDistance = 2000

	local function updateTeleportControls()
		updateToggleButton(teleportStopButton, "Stop Following", teleportFollowConnection ~= nil)
		updateToggleButton(teleportWallCheckButton, "Wall Check", teleportWallCheck)
	end

	local function getTeleportRoot()
		local character = localPlayer.Character
		return character and character:FindFirstChild("HumanoidRootPart"), character
	end

	local function isValidTeleportTarget(player)
		if player == localPlayer or player.Parent ~= Players then
			return false
		end
		if excludedUserIds[player.UserId] then
			return false
		end
		local character = player.Character
		local humanoid = character and character:FindFirstChildOfClass("Humanoid")
		local root = character and character:FindFirstChild("HumanoidRootPart")
		if not humanoid or humanoid.Health <= 0 or not root then
			return false
		end
		return true, character, root
	end

	local function canSeeTeleportTarget(myRoot, targetRoot)
		if not teleportWallCheck then
			return true
		end
		local origin = myRoot.Position + Vector3.new(0, 1, 0)
		local direction = targetRoot.Position - origin
		local params = RaycastParams.new()
		params.FilterType = Enum.RaycastFilterType.Exclude
		params.FilterDescendantsInstances = { localPlayer.Character }
		params.IgnoreWater = true
		local hit = workspace:Raycast(origin, direction, params)
		return hit == nil or hit.Instance:IsDescendantOf(targetRoot.Parent)
	end

	stopTeleportFollow = function()
		if teleportFollowConnection then
			teleportFollowConnection:Disconnect()
			teleportFollowConnection = nil
		end
		teleportFollowTarget = nil
		local character = localPlayer.Character
		local humanoid = character and character:FindFirstChildOfClass("Humanoid")
		if humanoid then
			humanoid.PlatformStand = false
		end
		updateTeleportControls()
	end

	local function startTeleportFollow(targetPlayer)
		stopTeleportFollow()
		if not targetPlayer then
			return
		end
		local myRoot, myCharacter = getTeleportRoot()
		if not myRoot then
			return
		end
		local humanoid = myCharacter:FindFirstChildOfClass("Humanoid")
		if not humanoid then
			return
		end

		teleportFollowTarget = targetPlayer
		humanoid.PlatformStand = true

		teleportFollowConnection = RunService.Heartbeat:Connect(function()
			if not teleportFollowTarget or teleportFollowTarget.Parent ~= Players then
				stopTeleportFollow()
				return
			end
			local myRootNow, myCharacterNow = getTeleportRoot()
			if not myRootNow then
				stopTeleportFollow()
				return
			end
			local ok, _, targetRoot = isValidTeleportTarget(teleportFollowTarget)
			if not ok or not targetRoot then
				stopTeleportFollow()
				return
			end

			local humanoidNow = myCharacterNow:FindFirstChildOfClass("Humanoid")
			if not humanoidNow or humanoidNow.Health <= 0 then
				stopTeleportFollow()
				return
			end

			local distance = (myRootNow.Position - targetRoot.Position).Magnitude
			if distance > teleportMaxDistance then
				stopTeleportFollow()
				return
			end

			if not canSeeTeleportTarget(myRootNow, targetRoot) then
				return
			end

			myRootNow.CFrame = targetRoot.CFrame + Vector3.new(0, teleportHeight, 0)
			myRootNow.AssemblyLinearVelocity = Vector3.zero
		end)

		updateTeleportControls()
	end

	local function teleportToPlayer(targetPlayer)
		local myRoot = getTeleportRoot()
		if not myRoot then
			return
		end
		local ok, _, targetRoot = isValidTeleportTarget(targetPlayer)
		if not ok or not targetRoot then
			return
		end
		myRoot.CFrame = targetRoot.CFrame + Vector3.new(0, teleportHeight, 0)
	end

	local function nearestTeleportTarget()
		local myRoot = getTeleportRoot()
		if not myRoot then
			return nil
		end
		local best, bestDist = nil, math.huge
		for _, player in ipairs(Players:GetPlayers()) do
			local ok, _, targetRoot = isValidTeleportTarget(player)
			if ok and targetRoot then
				local d = (myRoot.Position - targetRoot.Position).Magnitude
				if d <= teleportMaxDistance and d < bestDist and canSeeTeleportTarget(myRoot, targetRoot) then
					best = player
					bestDist = d
				end
			end
		end
		return best
	end

	-- UI: target selection list
	local teleportTargetLabel = Instance.new("TextLabel")
	teleportTargetLabel.Size = UDim2.new(1, -20, 0, 16)
	teleportTargetLabel.Position = UDim2.fromOffset(10, 2)
	teleportTargetLabel.BackgroundTransparency = 1
	teleportTargetLabel.Text = "TARGETS  /  CLICK TO TELEPORT"
	teleportTargetLabel.TextColor3 = theme.Accent
	teleportTargetLabel.Font = Enum.Font.GothamBold
	teleportTargetLabel.TextSize = 10
	teleportTargetLabel.TextXAlignment = Enum.TextXAlignment.Left
	teleportTargetLabel.Parent = teleportPage

	local teleportPlayerList = Instance.new("ScrollingFrame")
	teleportPlayerList.Name = "TeleportPlayerList"
	teleportPlayerList.Position = UDim2.fromOffset(10, 20)
	teleportPlayerList.Size = UDim2.new(1, -20, 0, 120)
	teleportPlayerList.BackgroundColor3 = theme.Surface
	teleportPlayerList.BorderSizePixel = 0
	teleportPlayerList.CanvasSize = UDim2.new(0, 0, 0, 0)
	teleportPlayerList.AutomaticCanvasSize = Enum.AutomaticSize.Y
	teleportPlayerList.ScrollBarThickness = 5
	teleportPlayerList.ScrollBarImageColor3 = theme.Accent
	teleportPlayerList.Parent = teleportPage

	local teleportListCorner = Instance.new("UICorner")
	teleportListCorner.CornerRadius = UDim.new(0, 6)
	teleportListCorner.Parent = teleportPlayerList

	local teleportListLayout = Instance.new("UIListLayout")
	teleportListLayout.Padding = UDim.new(0, 4)
	teleportListLayout.SortOrder = Enum.SortOrder.LayoutOrder
	teleportListLayout.Parent = teleportPlayerList

	local teleportListPadding = Instance.new("UIPadding")
	teleportListPadding.PaddingTop = UDim.new(0, 4)
	teleportListPadding.PaddingBottom = UDim.new(0, 4)
	teleportListPadding.PaddingLeft = UDim.new(0, 4)
	teleportListPadding.PaddingRight = UDim.new(0, 4)
	teleportListPadding.Parent = teleportPlayerList

	refreshTeleportPlayerList = function()
		for _, child in ipairs(teleportPlayerList:GetChildren()) do
			if child:IsA("TextButton") then
				child:Destroy()
			end
		end
		local players = Players:GetPlayers()
		table.sort(players, function(a, b)
			return string.lower(a.Name) < string.lower(b.Name)
		end)
		for index, player in ipairs(players) do
			if player ~= localPlayer then
				local listed = player
				local row = Instance.new("TextButton")
				row.Name = "TP_" .. tostring(listed.UserId)
				row.LayoutOrder = index
				row.Size = UDim2.new(1, -8, 0, 26)
				row.BackgroundColor3 = theme.Panel
				row.BorderSizePixel = 0
				row.Text = listed.DisplayName .. "  (@" .. listed.Name .. ")"
				row.TextColor3 = theme.Text
				row.TextXAlignment = Enum.TextXAlignment.Left
				row.Font = Enum.Font.GothamSemibold
				row.TextSize = 11
				row.Parent = teleportPlayerList
				local c = Instance.new("UICorner")
				c.CornerRadius = UDim.new(0, 5)
				c.Parent = row
				row.Activated:Connect(function()
					teleportToPlayer(listed)
				end)
			end
		end
	end

	-- Buttons
	local teleportToNearestButton = createToggleButton("Teleport to Nearest", 148, teleportPage)
	local teleportFollowButton = createToggleButton("Follow Nearest", 192, teleportPage)
	local teleportStopButton = createToggleButton("Stop Following", 236, teleportPage)
	local teleportWallCheckButton = createToggleButton("Wall Check", 280, teleportPage)

	teleportToNearestButton.Activated:Connect(function()
		local target = nearestTeleportTarget()
		if target then
			teleportToPlayer(target)
		end
	end)

	teleportFollowButton.Activated:Connect(function()
		if teleportFollowConnection then
			stopTeleportFollow()
		else
			local target = nearestTeleportTarget()
			if target then
				startTeleportFollow(target)
			end
		end
	end)

	teleportStopButton.Activated:Connect(function()
		stopTeleportFollow()
	end)

	teleportWallCheckButton.Activated:Connect(function()
		teleportWallCheck = not teleportWallCheck
		updateTeleportControls()
	end)

	refreshTeleportPlayerList()
	updateTeleportControls()
end
-- ============================================================================
-- END TELEPORT PAGE
-- ============================================================================

